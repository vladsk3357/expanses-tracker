# Supabase (Project Settings → API). Use anon legacy key or publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: new Supabase publishable key instead of anon:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GitHub Models (server only). Fine-grained PAT with "Models" read / models:read.
GITHUB_TOKEN=

# Optional: attribute usage to a GitHub org (uses /orgs/{org}/inference/...).
# GITHUB_MODELS_ORG=

# Optional: override default openai/gpt-4o-mini
# GITHUB_MODELS_MODEL=

# --- Production (Vercel + Supabase) ---
# 1. Vercel: set the same NEXT_PUBLIC_* and GITHUB_TOKEN in Project Settings → Environment Variables.
# 2. Supabase Auth → URL configuration: add https://YOUR_DOMAIN/auth/callback to Redirect URLs.
# 3. Google Cloud OAuth: authorized redirect URIs must match what Supabase uses for Google sign-in.
# 4. Run SQL migrations (supabase/migrations) against the linked project: `supabase db push` or paste in SQL Editor.
